# Kopieren nach .env.production und mit echten, PRODUKTIONS-Werten fuellen.
# .env.production NIEMALS ins Repo committen (siehe .gitignore).
# Genutzt von docker-compose.prod.yml - fuer die lokale Entwicklung
# weiterhin .env / .env.example verwenden (docker-compose.yml).

# Generieren mit z.B.: openssl rand -hex 32
POSTGRES_USER=lauftrainer
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=lauftrainer
# Muss zum POSTGRES_PASSWORD oben passen (beide muessen manuell synchron
# gehalten werden - Compose gibt POSTGRES_PASSWORD an den db-Container,
# waehrend api/worker stattdessen die volle DATABASE_URL lesen).
DATABASE_URL=postgresql://lauftrainer:change-me-to-a-long-random-value@db:5432/lauftrainer
REDIS_URL=redis://redis:6379/0

# Langer, zufaelliger Wert - signiert die Login-Tokens. Generieren mit
# z.B.: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-value

# Oeffentliche Adresse der Seite: zunaechst die Server-IP (z.B.
# http://203.0.113.10), sobald eine Domain eingerichtet ist stattdessen
# https://eure-domain.tld - dann zusaetzlich in ../Caddyfile die Adresse
# `:80` durch dieselbe Domain ersetzen, damit Caddy automatisch ein
# Let's-Encrypt-Zertifikat holt.
FRONTEND_ORIGIN=http://<server-ip>

# Zusaetzliche, durch Komma getrennte Origins, die CORS-seitig ebenfalls
# erlaubt werden - z.B. relevant, wenn das Frontend testweise zusaetzlich
# unter einer zweiten Adresse laeuft (siehe README.md, Abschnitt
# "Testbetrieb auf GitHub Pages"): FRONTEND_ORIGIN bleibt dabei die fuer
# generierte Links (Passwort-Reset-Mail) genutzte Haupt-Origin. Leer lassen,
# wenn nur FRONTEND_ORIGIN erlaubt sein soll (Standardfall).
CORS_EXTRA_ORIGINS=

# Leer lassen: Caddy stellt Frontend und Backend unter derselben Origin
# bereit (siehe ../Caddyfile), Anfragen des Browsers an /api/... bleiben
# damit same-origin - kein CORS, kein Mixed-Content. NICHT auf eine eigene
# URL setzen, ausser Backend und Frontend sollen bewusst unterschiedliche
# Origins haben.
NEXT_PUBLIC_API_URL=

# SMTP fuer den "Passwort vergessen"-Mailversand - ohne SMTP_HOST bleibt es
# leer und die Mail wird nur geloggt statt tatsaechlich verschickt (siehe
# app/services/email.py), was im oeffentlichen Betrieb i.d.R. nicht
# gewuenscht ist.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@lauftrainer.app
SMTP_USE_TLS=true
